{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "NASCON-GJ.slnx",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#6e5ce0",
        "titleBar.activeForeground": "#ECECF0",
        "titleBar.inactiveBackground": "#6e5ce0b3",
        "titleBar.inactiveForeground": "#ECECF0",
        "titleBar.border": "#e8e2ff",
        "statusBar.background": "#6e5ce0",
        "statusBar.foreground": "#ECECF0",
        "statusBarItem.hoverBackground": "#e8e2ff59",
        "statusBarItem.remoteBackground": "#6e5ce0",
        "statusBarItem.remoteForeground": "#ECECF0",
        "activityBar.activeBorder": "#6e5ce0",
        "activityBarBadge.background": "#6e5ce0",
        "activityBarBadge.foreground": "#ECECF0",
        "editorGroup.border": "#6e5ce073",
        "panel.border": "#6e5ce073",
        "sideBar.border": "#6e5ce073",
        "focusBorder": "#6e5ce0",
        "editor.background": "#22212c",
        "editorGutter.background": "#22212c",
        "editorStickyScroll.background": "#22212c",
        "editorStickyScrollHover.background": "#22212c",
        "breadcrumb.background": "#22212c",
        "sideBar.background": "#22212c",
        "sideBarSectionHeader.background": "#22212c",
        "panel.background": "#22212c",
        "panelSectionHeader.background": "#22212c",
        "terminal.background": "#22212c",
        "editorGroupHeader.tabsBackground": "#22212c",
        "tab.inactiveBackground": "#22212c",
        "tab.activeBackground": "#22212c",
        "tab.activeBorderTop": "#6e5ce0",
        "commandCenter.background": "#6e5ce0",
        "commandCenter.foreground": "#ECECF0",
        "commandCenter.activeBackground": "#6e5ce0",
        "commandCenter.activeForeground": "#ECECF0",
        "commandCenter.inactiveForeground": "#ECECF099",
        "commandCenter.border": "#ECECF04d",
        "__omnify": "alienx:balanced"
    },
    "omnify.alien": "alienx"
}