{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.gitmodules": true,
        "**/.vsconfig": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "Logs/": true,
        "logs/": true,
        "ProjectSettings/": true,
        "UserSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "NASCON-GJ.slnx",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#e86f4e",
        "titleBar.activeForeground": "#ECECF0",
        "titleBar.inactiveBackground": "#e86f4eb3",
        "titleBar.inactiveForeground": "#ECECF0",
        "titleBar.border": "#4a2418",
        "statusBar.background": "#e86f4e",
        "statusBar.foreground": "#ECECF0",
        "statusBarItem.hoverBackground": "#4a241859",
        "statusBarItem.remoteBackground": "#e86f4e",
        "statusBarItem.remoteForeground": "#ECECF0",
        "activityBar.activeBorder": "#e86f4e",
        "activityBarBadge.background": "#e86f4e",
        "activityBarBadge.foreground": "#ECECF0",
        "editorGroup.border": "#e86f4e73",
        "panel.border": "#e86f4e73",
        "sideBar.border": "#e86f4e73",
        "focusBorder": "#e86f4e",
        "editor.background": "#282224",
        "editorGutter.background": "#282224",
        "editorStickyScroll.background": "#282224",
        "editorStickyScrollHover.background": "#282224",
        "breadcrumb.background": "#282224",
        "sideBar.background": "#282224",
        "sideBarSectionHeader.background": "#282224",
        "panel.background": "#282224",
        "panelSectionHeader.background": "#282224",
        "terminal.background": "#282224",
        "editorGroupHeader.tabsBackground": "#282224",
        "tab.inactiveBackground": "#282224",
        "tab.activeBackground": "#282224",
        "tab.activeBorderTop": "#e86f4e",
        "commandCenter.background": "#e86f4e",
        "commandCenter.foreground": "#ECECF0",
        "commandCenter.activeBackground": "#e86f4e",
        "commandCenter.activeForeground": "#ECECF0",
        "commandCenter.inactiveForeground": "#ECECF099",
        "commandCenter.border": "#ECECF04d",
        "__omnify": "heatblast:balanced"
    },
    "omnify.alien": "heatblast"
}